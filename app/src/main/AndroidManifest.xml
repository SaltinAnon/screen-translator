<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 阶段三：云端多模态翻译 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 阶段四：悬浮窗（TYPE_APPLICATION_OVERLAY） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 阶段一 + Android 14+ 合规：mediaProjection 类型前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 13+ 前台服务常驻通知需要通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".ScreenTranslatorApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenTranslator"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          仅用于「在 Activity 上下文中」弹出系统投屏授权对话框。
          QS 磁贴无法直接申请 MediaProjection 授权，必须经由此透明 Activity。
        -->
        <activity
            android:name=".ui.ProjectionRequestActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ScreenTranslator.Translucent" />

        <!-- 阶段一：前台服务，foregroundServiceType 为 Android 14+ 硬性要求 -->
        <!--
          configChanges：声明之后系统不会因为转屏而重启服务，服务的资源/显示器监听
          能继续用同一套状态工作（取帧尺寸由 DisplayManager 监听主动重建）。
        -->
        <service
            android:name=".service.TranslationForegroundService"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 阶段四：快捷设置磁贴 -->
        <service
            android:name=".service.TranslationTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_tile_translate"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
